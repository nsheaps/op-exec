#!/usr/bin/env bash
#
# op-exec - Execute a command with 1Password secrets as environment variables
#
# Similar to `doppler run`, but uses a 1Password item as the config source.
# Field values can be raw values or op:// references that get recursively resolved.
#
# Usage:
#   op-exec [options] op://vault/item -- command [args...]
#   op-exec [options] op://vault/item  # just print exports (for debugging)
#
# Examples:
#   op-exec op://Development/my-app-config -- npm start
#   op-exec op://Work/aws-creds -- aws s3 ls
#
# Field labels are converted to valid env var names:
#   "API Key" -> API_KEY
#   "database-url" -> DATABASE_URL
#
# POC Limitations:
#   - No section handling (flat items only)
#   - Max recursion depth: 5
#   - Only STRING and CONCEALED field types exported
#

set -euo pipefail

# -----------------------------------------------------------------------------
# Config
# -----------------------------------------------------------------------------
MAX_DEPTH=5
DEBUG=${DEBUG:-}

# Global flag: set to "1" by resolve_value_to if any resolution hop is CONCEALED.
# Must be reset to "" before each top-level resolve_value_to call.
_RESOLVE_CONCEALED=""

# Cache for op item get JSON responses: key = "vault/item", value = JSON string.
# Avoids repeated API calls when get_ref_type is called multiple times for the
# same item (e.g. multiple fields in one item reference another item).
declare -A _OP_ITEM_TYPE_CACHE

# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
debug() {
  if [[ -n "$DEBUG" ]]; then
    echo "[DEBUG] $*" >&2
  fi
}

error() {
  echo "op-exec: error: $*" >&2
}

fatal() {
  error "$@"
  exit 1
}

# Convert label to valid env var name: uppercase, spaces/hyphens to underscores
to_env_name() {
  echo "$1" | tr '[:lower:]' '[:upper:]' | tr ' -' '__' | tr -cd 'A-Z0-9_'
}

# Check if value looks like an op:// reference
is_op_ref() {
  [[ "$1" =~ ^op:// ]]
}

# Resolve an op:// reference
resolve_ref() {
  local ref="$1"
  debug "Resolving: $ref"
  op read "$ref" || true
}

# -----------------------------------------------------------------------------
# Type resolution
# -----------------------------------------------------------------------------

# get_ref_type OP_FIELD_REF
#
# Prints the field type (e.g. CONCEALED, STRING) for an op://vault/item/field
# reference. Returns empty string for 2-segment op://vault/item refs — those
# refer to an entire item rather than a single field, so a single type cannot
# be determined without inspecting all fields.
#
# Uses _OP_ITEM_TYPE_CACHE (keyed by "vault/item") to avoid redundant API calls
# when multiple fields in the same item are inspected.
get_ref_type() {
  local ref="$1"
  # Strip op:// prefix and split into segments
  local path="${ref#op://}"
  local vault item remainder field

  vault="${path%%/*}"
  remainder="${path#*/}"
  item="${remainder%%/*}"
  field="${remainder#*/}"

  # If field == item remainder after stripping item, there was no third segment
  if [[ "$field" == "$item" ]]; then
    # 2-segment op://vault/item reference: cannot determine a single field type.
    # Whether such a cross-item reference is CONCEALED cannot be inferred without
    # inspecting every field in the referenced item. Callers should treat 2-segment
    # refs conservatively (i.e. assume non-CONCEALED unless the top-level field says so).
    debug "get_ref_type: no field segment in $ref — cannot determine type"
    return
  fi

  local cache_key="${vault}/${item}"
  local item_json

  if [[ -n "${_OP_ITEM_TYPE_CACHE[$cache_key]:-}" ]]; then
    item_json="${_OP_ITEM_TYPE_CACHE[$cache_key]}"
    debug "get_ref_type: cache hit for $cache_key"
  else
    debug "get_ref_type: fetching $cache_key"
    item_json=$(op item get "$item" --vault "$vault" --format json 2>/dev/null || true)
    _OP_ITEM_TYPE_CACHE["$cache_key"]="$item_json"
  fi

  if [[ -z "$item_json" ]]; then
    debug "get_ref_type: empty response for $cache_key"
    return
  fi

  printf '%s' "$item_json" | jq -r --arg f "$field" \
    '.fields[]? | select(.label == $f) | .type' 2>/dev/null | head -1
}

# -----------------------------------------------------------------------------
# Main Logic
# -----------------------------------------------------------------------------

# resolve_value_to OUT_VAR VALUE [DEPTH]
#
# Recursively resolves VALUE until it is no longer an op:// reference (or
# MAX_DEPTH is reached), writing the final value into the variable named by
# OUT_VAR via printf -v (no subshell, so _RESOLVE_CONCEALED assignments
# are visible to the caller).
#
# Sets _RESOLVE_CONCEALED=1 if any resolution hop targets a CONCEALED field.
# Callers MUST reset _RESOLVE_CONCEALED="" before calling this function if
# they want a clean per-variable concealed flag.
resolve_value_to() {
  local _out_var="$1"
  local value="$2"
  local depth="${3:-0}"

  if [[ $depth -ge $MAX_DEPTH ]]; then
    debug "Max depth reached for value"
    printf -v "$_out_var" '%s' "$value"
    return
  fi

  if is_op_ref "$value"; then
    local ref_type
    ref_type=$(get_ref_type "$value")
    if [[ "$ref_type" == "CONCEALED" ]]; then
      _RESOLVE_CONCEALED=1
      debug "resolve_value_to: hop is CONCEALED ($value)"
    fi
    # NOTE: name MUST NOT be "resolved" — callers (e.g. the main field-iteration
    # loop) use `local resolved; resolve_value_to resolved "$value"` and bash
    # dynamic scoping makes a local of the same name here shadow the caller's,
    # so `printf -v "$_out_var"` would target THIS local (destroyed on return)
    # instead of the caller's, leaving caller's resolved=stale from the previous
    # iteration. Distinct name (_rv_resolved) avoids the shadow.
    local _rv_resolved
    _rv_resolved=$(resolve_ref "$value")
    if [[ -n "$_rv_resolved" ]]; then
      resolve_value_to "$_out_var" "$_rv_resolved" $((depth + 1))
    else
      debug "Failed to resolve: $value"
      printf -v "$_out_var" '%s' "$value"
    fi
  else
    printf -v "$_out_var" '%s' "$value"
  fi
}

# resolve_value VALUE [DEPTH]
#
# Legacy wrapper used by callers that need the resolved value on stdout
# (e.g. the "print exports" no-command path). Does NOT track CONCEALED state.
resolve_value() {
  local value="$1"
  local depth="${2:-0}"
  local _rv_result
  resolve_value_to _rv_result "$value" "$depth"
  echo "$_rv_result"
}

# Parse op://vault/item reference
parse_ref() {
  local ref="$1"

  # Strip op:// prefix
  local path="${ref#op://}"

  # Split by /
  local vault="${path%%/*}"
  local item="${path#*/}"
  # Remove any trailing field references (we want the item)
  item="${item%%/*}"

  echo "$vault" "$item"
}

# Fetch item and extract fields
fetch_fields() {
  local vault="$1"
  local item="$2"

  debug "Fetching: vault=$vault item=$item"

  # Get item as JSON and extract fields
  # Filter to STRING and CONCEALED types, output one compact JSON object per line.
  # Using jq -c avoids jq -r converting escaped \n sequences to real newlines.
  # Include .type so the caller can distinguish CONCEALED from STRING fields.
  op item get "$item" --vault "$vault" --format json |
    jq -c '.fields[]? | select(.type == "STRING" or .type == "CONCEALED") | {label: .label, value: (.value // ""), type: .type}'
}

# -----------------------------------------------------------------------------
# Entry Point
# -----------------------------------------------------------------------------

show_help() {
  cat <<'EOF'
op-exec - Execute a command with 1Password secrets as environment variables

Usage:
  op-exec [options] op://vault/item -- command [args...]
  op-exec [options] op://vault/item  # print exports (for debugging/sourcing)

Options:
  -h, --help                 Show this help
  -d, --debug                Enable debug output
  --concealed-file FILE      Append CONCEALED var names (one per line) to FILE
  --concealed-kv-file FILE   Write CONCEALED NAME=value pairs (one per line) to
                             FILE. File is chmod 600 since it carries secret
                             values. Multi-line values (e.g. PEM keys) are
                             skipped — only single-line values are emitted.
                             Existing FILE is truncated before write.

Examples:
  op-exec op://Development/my-app-config -- npm start
  op-exec op://Work/aws-creds -- aws s3 ls

  # Source into current shell
  eval "$(op-exec op://vault/item)"

  # Track which vars are secrets for downstream redaction (names only)
  op-exec --concealed-file /tmp/.env.secrets op://vault/item -- npm start

  # Materialize NAME=value pairs for downstream redaction without env lookup
  op-exec --concealed-kv-file /tmp/.env.secrets.values op://vault/item -- npm start

Environment:
  DEBUG=1       Enable debug output
EOF
}

main() {
  local CONCEALED_FILE=""
  local CONCEALED_KV_FILE=""

  # Parse flags
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
      show_help
      exit 0
      ;;
    -d | --debug)
      DEBUG=1
      shift
      ;;
    --concealed-file)
      [[ $# -lt 2 ]] && fatal "--concealed-file requires a FILE argument"
      CONCEALED_FILE="$2"
      shift 2
      ;;
    --concealed-kv-file)
      [[ $# -lt 2 ]] && fatal "--concealed-kv-file requires a FILE argument"
      CONCEALED_KV_FILE="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    op://*)
      # Found the reference, stop parsing flags
      break
      ;;
    *)
      fatal "Unknown option: $1"
      ;;
    esac
  done

  # Need at least the op:// reference
  if [[ $# -lt 1 ]]; then
    show_help
    exit 1
  fi

  local ref="$1"
  shift

  # Validate reference format
  if ! [[ "$ref" =~ ^op://[^/]+/[^/]+ ]]; then
    fatal "Invalid reference format: $ref (expected op://vault/item)"
  fi

  # Check dependencies
  command -v op >/dev/null 2>&1 || fatal "1Password CLI (op) not found"
  command -v jq >/dev/null 2>&1 || fatal "jq not found"

  # Check if signed in (use whoami, not account list — account list
  # doesn't work with service account tokens)
  if ! op whoami >/dev/null 2>&1; then
    fatal "Not signed in to 1Password. Run 'op signin' first, or set OP_SERVICE_ACCOUNT_TOKEN."
  fi

  # Parse reference
  read -r vault item <<<"$(parse_ref "$ref")"
  debug "Parsed: vault=$vault item=$item"

  # Fetch and process fields
  declare -A env_vars
  declare -A env_concealed

  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local label value type env_name
    label=$(echo "$line" | jq -r '.label')
    value=$(echo "$line" | jq -r '.value')
    type=$(echo "$line" | jq -r '.type')
    [[ -z "$label" ]] && continue

    env_name=$(to_env_name "$label")

    debug "Processing: $label -> $env_name (type=$type)"

    # Reset the concealed-chain flag before each field so each variable gets
    # an independent concealed determination.
    _RESOLVE_CONCEALED=""
    local resolved
    resolve_value_to resolved "$value"

    env_vars["$env_name"]="$resolved"

    # Mark as concealed if the top-level field is CONCEALED, or if any
    # hop in the op:// resolution chain was CONCEALED.
    if [[ "$type" == "CONCEALED" || -n "$_RESOLVE_CONCEALED" ]]; then
      env_concealed["$env_name"]=1
      debug "Marking $env_name as concealed"
    fi
  done < <(fetch_fields "$vault" "$item")

  # Write concealed var names to --concealed-file if requested.
  # Written before exec so the file is populated even if the child process exits non-zero.
  if [[ -n "$CONCEALED_FILE" ]]; then
    for name in "${!env_concealed[@]}"; do
      printf '%s\n' "$name" >>"$CONCEALED_FILE"
    done
    debug "Wrote ${#env_concealed[@]} concealed var name(s) to $CONCEALED_FILE"
  fi

  # Write NAME=value pairs to --concealed-kv-file if requested.
  # File is truncated (not appended) and chmod'd 0600 — it carries secret values.
  # Multi-line values are skipped: the file format is one entry per line, so
  # values containing newlines would break parsing. Consumers (the 1pass plugin
  # redact-secrets hook) currently skip multi-line values anyway, so this is
  # the same constraint as the existing --concealed-file pathway.
  if [[ -n "$CONCEALED_KV_FILE" ]]; then
    : >"$CONCEALED_KV_FILE"
    chmod 0600 "$CONCEALED_KV_FILE"
    local kv_written=0 kv_skipped=0
    for name in "${!env_concealed[@]}"; do
      local val="${env_vars[$name]}"
      if [[ "$val" == *$'\n'* ]]; then
        debug "Skipping multi-line concealed value: $name"
        kv_skipped=$((kv_skipped + 1))
        continue
      fi
      printf '%s=%s\n' "$name" "$val" >>"$CONCEALED_KV_FILE"
      kv_written=$((kv_written + 1))
    done
    debug "Wrote ${kv_written} NAME=value pair(s) (skipped ${kv_skipped} multi-line) to $CONCEALED_KV_FILE"
  fi

  # If no command provided, just print exports
  if [[ $# -eq 0 ]]; then
    for name in "${!env_vars[@]}"; do
      printf 'export %s=%q\n' "$name" "${env_vars[$name]}"
    done
    exit 0
  fi

  # Otherwise, export and exec
  for name in "${!env_vars[@]}"; do
    export "$name"="${env_vars[$name]}"
    debug "Exported: $name"
  done

  debug "Executing: $*"
  exec "$@"
}

main "$@"
